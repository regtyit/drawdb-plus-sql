# Port the API server listens on
POSTGRES_API_PORT=5001

# Interface to bind. Keep 127.0.0.1 for local-only access.
POSTGRES_API_HOST=127.0.0.1

# Comma separated list of allowed CORS origins. Use * to allow any.
POSTGRES_API_CORS_ORIGIN=http://localhost:3148

# Optional shared secret. If set, the frontend must send it as
# the "x-drawdb-token" header (set VITE_POSTGRES_API_TOKEN accordingly).
POSTGRES_API_TOKEN=

# Default statement timeout for every query, in milliseconds (0 = disabled).
POSTGRES_API_STATEMENT_TIMEOUT=30000

# Maximum number of rows returned per result set.
POSTGRES_API_MAX_ROWS=5000

# Idle timeout (ms) after which a cached connection pool is closed.
POSTGRES_API_POOL_IDLE=60000
